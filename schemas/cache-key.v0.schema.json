{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackc6/lintel/schemas/cache-key.v0.schema.json",
  "title": "LintelCacheKey",
  "description": "Content-addressed freeze key. Same key after a model or compiler swap must replay the same admit decision or hard-fail. Never silently serve a new kernel. Fields are graph, hw, compiler, adapter, policy — not model_id, not enum_id, not Kernel.target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_hash", "hw_id", "compiler_ver", "adapter_id", "policy_id"],
  "properties": {
    "schema_version": { "const": "cache-key.v0" },
    "graph_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hw_id": { "type": "string", "minLength": 1 },
    "compiler_ver": { "type": "string", "minLength": 1 },
    "adapter_id": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string", "minLength": 1 }
  }
}
